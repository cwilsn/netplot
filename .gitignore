!.env.*.example
!.env.sample
!.env.*.sample
/config.local/
*.local.env
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# Network captures, exported samples, and local screenshots
/captures/
/exports/
*.pcap
*.pcapng
